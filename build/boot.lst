    13                                  %include "gdt.inc"
     1                              <1> ; Minimal flat GDT for 32-bit protected mode.
     2                              <1> ; Code and data segments both cover the full 4 GiB address space (base 0).
     3                              <1> 
     4                              <1> gdt_start:
     5 000000BC 0000000000000000    <1>     dq 0                         ; [0] null descriptor (required)
     6                              <1> 
     7                              <1> gdt_code:
     8 000000C4 FFFF                <1>     dw 0xFFFF                    ; limit 15:0
     9 000000C6 0000                <1>     dw 0                         ; base 15:0
    10 000000C8 00                  <1>     db 0                         ; base 23:16
    11 000000C9 9A                  <1>     db 10011010b                 ; present, ring 0, code, executable, readable
    12 000000CA CF                  <1>     db 11001111b                 ; 4 KiB granularity, 32-bit, limit 19:16
    13 000000CB 00                  <1>     db 0                         ; base 31:24
    14                              <1> 
    15                              <1> gdt_data:
    16 000000CC FFFF                <1>     dw 0xFFFF
    17 000000CE 0000                <1>     dw 0
    18 000000D0 00                  <1>     db 0
    19 000000D1 92                  <1>     db 10010010b                 ; present, ring 0, data, writable
    20 000000D2 CF                  <1>     db 11001111b
    21 000000D3 00                  <1>     db 0
    22                              <1> 
    23                              <1> gdt_end:
    24                              <1> 
    25                              <1> gdt_descriptor:
    26 000000D4 1700                <1>     dw gdt_end - gdt_start - 1
    27 000000D6 [BC000000]          <1>     dd gdt_start
