    98                                  %include "pm.inc"
     1                              <1> ; Switch from real mode to 32-bit protected mode, then jump to the kernel.
     2                              <1> ; Does not return.
     3                              <1> ;
     4                              <1> ; Stack note: PM_STACK_TOP is a *temporary* stack for the first instructions in
     5                              <1> ; protected mode.  kernel/entry.asm replaces it with the linker-reserved C stack
     6                              <1> ; before calling kmain().
     7                              <1> 
     8                              <1> enter_protected_mode:
     9 000001A3 FA                  <1>     cli
    10 000001A4 0F0116[D400]        <1>     lgdt [gdt_descriptor]
    11                              <1> 
    12 000001A9 0F20C0              <1>     mov eax, cr0
    13 000001AC 6683C801            <1>     or eax, 1                    ; set PE (Protection Enable)
    14 000001B0 0F22C0              <1>     mov cr0, eax
    15                              <1> 
    16                              <1>     ; Far jump flushes the prefetch queue and loads CS with the code selector.
    17 000001B3 EA[B801]0800        <1>     jmp GDT_CODE_SEL:pm_entry
    18                              <1> 
    19                              <1> bits 32
    20                              <1> pm_entry:
    21 000001B8 66B81000            <1>     mov ax, GDT_DATA_SEL
    22 000001BC 8ED8                <1>     mov ds, ax
    23 000001BE 8EC0                <1>     mov es, ax
    24 000001C0 8EE0                <1>     mov fs, ax
    25 000001C2 8EE8                <1>     mov gs, ax
    26 000001C4 8ED0                <1>     mov ss, ax
    27 000001C6 BC00000900          <1>     mov esp, PM_STACK_TOP
    28                              <1> 
    29                              <1>     ; Absolute far jump — plain "jmp 0x10000" assembles as a relative near jmp!
    30 000001CB EA000001000800      <1>     jmp GDT_CODE_SEL:KERNEL_PHYS
